<?xml version="1.0" encoding="UTF-8"?>
<!--
  COMMON-EVENTS: plain library jar (NOT a Spring Boot app) holding the Kafka
  message contracts shared by every producer and consumer.

  WHY A SHARED CONTRACT MODULE?
  Producer and consumer must agree on the shape of a message. Putting the
  records in one artifact guarantees that at compile time. The trade-off
  (worth mentioning in interviews): a shared jar couples services at build
  time - large orgs prefer a Schema Registry (Avro/Protobuf) so each service
  can evolve independently with enforced compatibility rules.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shopflow</groupId>
        <artifactId>shopflow-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>common-events</artifactId>
    <name>ShopFlow :: Common Events</name>

    <dependencies>
        <!-- Only Jackson annotations (@JsonIgnoreProperties for tolerant readers).
             Deliberately NO Spring dependency: contracts should be framework-free. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- The Boot parent activates repackaging; a plain library must skip it,
                 otherwise Maven fails looking for a main class. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
