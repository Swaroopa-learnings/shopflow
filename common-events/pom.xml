<?xml version="1.0" encoding="UTF-8"?>
<!--
  A plain library jar holding the Kafka message contracts shared by every
  producer and consumer, so both sides agree on the shape at compile time.
  Larger systems often use a schema registry instead.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.shopflow</groupId>
        <artifactId>shopflow-parent</artifactId>
        <version>1.0.0</version>
    </parent>
    <artifactId>common-events</artifactId>
    <name>ShopFlow :: Common Events</name>

    <dependencies>
        <!-- Jackson annotations only; no Spring dependency here on purpose. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Skip repackaging: this is a library, not an application. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
